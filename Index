<script>
// Навигация по страницам
function showPage(pageId) {
    document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
    document.querySelectorAll('.nav-menu button').forEach(a => a.classList.remove('active'));
    const page = document.getElementById('page-' + pageId);
    if (page) page.classList.add('active');
    const link = document.querySelector('.nav-menu button[data-page="' + pageId + '"]');
    if (link) link.classList.add('active');
    document.querySelector('.nav-menu').classList.remove('open');
    window.scrollTo({ top: 0, behavior: 'smooth' });
}

// Обработка ошибок картинок
function imgFail(img, label) {
    if (img.dataset.failed) return;
    img.dataset.failed = '1';
    const ph = document.createElement('div');
    ph.className = 'img-ph';
    ph.innerHTML = '<div class="ico">❦</div><div class="lbl">' + (label || img.alt || 'Изображение') + '</div><div class="hnt">Изображение недоступно</div>';
    img.parentNode.insertBefore(ph, img);
    img.style.display = 'none';
}

// Аккордеоны
document.querySelectorAll('.accordion-header').forEach(header => {
    header.setAttribute('aria-expanded', 'false');
    header.addEventListener('click', () => {
        const body = header.nextElementSibling;
        const active = header.classList.contains('active');
        header.classList.toggle('active', !active);
        header.setAttribute('aria-expanded', String(!active));
        body.style.maxHeight = active ? null : body.scrollHeight + 'px';
    });
});

// Карусели
document.querySelectorAll('[data-carousel]').forEach(carousel => {
    const slides = [...carousel.querySelectorAll('.carousel-slide')];
    const dotsBox = carousel.querySelector('.carousel-dots');
    const captionEl = carousel.querySelector('.carousel-caption');
    if (!slides.length || !dotsBox) return;

    slides.forEach(slide => {
        const src = slide.dataset.src;
        if (!src) return;
        const probe = new Image();
        probe.referrerPolicy = 'no-referrer';
        probe.onload = () => { slide.style.backgroundImage = 'url("' + src + '")'; slide.classList.add('slide-loaded'); };
        probe.src = src;
    });

    dotsBox.innerHTML = '';
    slides.forEach((_, i) => { const d = document.createElement('span'); d.dataset.index = i; dotsBox.appendChild(d); });
    const dots = [...dotsBox.children];
    let current = Math.max(0, slides.findIndex(s => s.classList.contains('active')));

    function render() {
        slides.forEach((s, i) => s.classList.toggle('active', i === current));
        dots.forEach((d, i) => d.classList.toggle('active', i === current));
        if (captionEl) captionEl.textContent = slides[current].dataset.caption || '';
    }
    let timer;
    function restart() { clearInterval(timer); if (slides.length > 1) timer = setInterval(() => { current = (current + 1) % slides.length; render(); }, 6000); }
    function go(i) { current = (i + slides.length) % slides.length; render(); restart(); }

    carousel.addEventListener('click', e => {
        const btn = e.target.closest('.carousel-btn');
        if (btn) { e.preventDefault(); go(current + (btn.classList.contains('prev') ? -1 : 1)); return; }
        const dot = e.target.closest('.carousel-dots span');
        if (dot) go(Number(dot.dataset.index));
    });
    let sx = null;
    carousel.addEventListener('touchstart', e => { sx = e.touches[0].clientX; }, { passive: true });
    carousel.addEventListener('touchend', e => {
        if (sx === null) return;
        const dx = e.changedTouches[0].clientX - sx;
        if (Math.abs(dx) > 40) go(current + (dx < 0 ? 1 : -1));
        sx = null;
    });
    render();
    restart();
});

// ИНТЕРАКТИВНАЯ КАРТА "ГЕНИЙ МЕСТА"
document.querySelectorAll('.map-btn').forEach(btn => {
    btn.addEventListener('click', () => {
        document.querySelectorAll('.map-btn').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.location-card').forEach(c => c.classList.remove('active'));
        
        btn.classList.add('active');
        const targetId = btn.getAttribute('data-target');
        document.getElementById(targetId).classList.add('active');
    });
});

// ИГРА НА СОПОСТАВЛЕНИЕ (MATCHING GAME)
function initMatchGame(containerId, resultId) {
    const container = document.getElementById(containerId);
    if (!container) return;
    
    const items = container.querySelectorAll('.match-item');
    let selectedItem = null;

    items.forEach(item => {
        item.addEventListener('click', () => {
            if (item.classList.contains('matched')) return;

            if (!selectedItem) {
                selectedItem = item;
                item.classList.add('selected');
            } else {
                if (selectedItem === item) {
                    selectedItem.classList.remove('selected');
                    selectedItem = null;
                    return;
                }

                const matchValue1 = selectedItem.getAttribute('data-match');
                const matchValue2 = item.getAttribute('data-match');

                if (matchValue1 === matchValue2) {
                    selectedItem.classList.remove('selected');
                    selectedItem.classList.add('matched');
                    item.classList.add('matched');
                    selectedItem = null;
                    
                    if (container.querySelectorAll('.matched').length === items.length) {
                        const res = document.getElementById(resultId);
                        res.textContent = "Отлично! Все пары найдены верно.";
                        res.style.color = "var(--accent-hover)";
                    }
                } else {
                    const originalSelected = selectedItem;
                    item.classList.add('selected'); 
                    setTimeout(() => {
                        originalSelected.classList.remove('selected');
                        item.classList.remove('selected');
                    }, 500);
                    selectedItem = null;
                }
            }
        });
    });
}

// Инициализация игр при загрузке
initMatchGame('match-hmelita', 'result-hmelita');
initMatchGame('match-christian', 'result-christian');

// ЛОГИКА ДЛЯ ТЕСТА (QUIZ)
function checkQuiz(quizId, correctAnswers, resultId) {
    const quiz = document.getElementById(quizId);
    const resultDiv = document.getElementById(resultId);
    let score = 0;
    let total = Object.keys(correctAnswers).length;

    for (let q in correctAnswers) {
        const selected = quiz.querySelector(`input[name="${q}"]:checked`);
        if (selected && selected.value === correctAnswers[q]) {
            score++;
        }
    }

    resultDiv.className = 'quiz-result ' + (score === total ? 'correct' : 'incorrect');
    if (score === total) {
        resultDiv.textContent = "Превосходно! Вы отлично разбираетесь в христианских мотивах.";
    } else {
        resultDiv.textContent = `Вы ответили правильно на ${score} из ${total} вопросов. Попробуйте еще раз, перечитав материал!`;
    }
}
</script>

